{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "past-curfew/map.schema.json",
  "title": "Past Curfew map",
  "type": "object",
  "required": [
    "meta",
    "bounds",
    "levels",
    "zones",
    "rooms",
    "stairs",
    "connections",
    "loot_nodes",
    "hiding_spots",
    "patrol_routes",
    "entity_spawns",
    "extractions",
    "streaming_regions",
    "spawn",
    "pacing"
  ],
  "additionalProperties": false,
  "definitions": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "[X,Y,Z] studs. X=long axis, Y=up."
    },
    "door": {
      "type": "object",
      "required": [
        "at",
        "w",
        "h"
      ],
      "additionalProperties": true,
      "properties": {
        "at": {
          "$ref": "#/definitions/vec3"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      }
    }
  },
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "name",
        "version",
        "units",
        "stud_to_m",
        "grid",
        "prop_snap",
        "axis",
        "speeds"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "units": {
          "const": "stud"
        },
        "stud_to_m": {
          "type": "number"
        },
        "grid": {
          "type": "number",
          "description": "all room dims/origins multiples of this"
        },
        "prop_snap": {
          "type": "number"
        },
        "axis": {
          "type": "object",
          "required": [
            "up",
            "long"
          ],
          "properties": {
            "up": {
              "const": "Y"
            },
            "long": {
              "const": "X"
            }
          }
        },
        "speeds": {
          "type": "object",
          "required": [
            "walk",
            "sneak",
            "loaded_mid",
            "loaded_max"
          ],
          "properties": {
            "walk": {
              "type": "number"
            },
            "sneak": {
              "type": "number"
            },
            "loaded_mid": {
              "type": "number"
            },
            "loaded_max": {
              "type": "number"
            }
          }
        }
      }
    },
    "bounds": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "$ref": "#/definitions/vec3"
        },
        "max": {
          "$ref": "#/definitions/vec3"
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "floorY",
          "height"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "floorY": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "origin",
          "size",
          "kind"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "origin": {
            "$ref": "#/definitions/vec3"
          },
          "size": {
            "$ref": "#/definitions/vec3"
          },
          "kind": {
            "enum": [
              "corridor",
              "lobby",
              "courtyard",
              "vault",
              "open"
            ]
          }
        }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "slot",
          "origin",
          "size",
          "variants"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "slot": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "origin": {
            "$ref": "#/definitions/vec3"
          },
          "size": {
            "$ref": "#/definitions/vec3"
          },
          "variants": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "string"
            },
            "description": "same footprint + door positions; interior layout differs"
          }
        }
      }
    },
    "stairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "connects",
          "footprints"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "const": "stair"
          },
          "connects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "footprints": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "level",
                "origin",
                "size"
              ],
              "properties": {
                "level": {
                  "type": "string"
                },
                "origin": {
                  "$ref": "#/definitions/vec3"
                },
                "size": {
                  "$ref": "#/definitions/vec3"
                }
              }
            }
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "a",
          "b",
          "kind",
          "optional"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "door",
              "open",
              "stair",
              "vent",
              "hatch"
            ]
          },
          "optional": {
            "type": "boolean"
          },
          "opened_prob": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2,
            "description": "[min,max] runtime open probability for optional connectors"
          },
          "at": {
            "$ref": "#/definitions/vec3"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          }
        }
      }
    },
    "loot_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "room",
          "pos",
          "tier"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "room": {
            "type": "string"
          },
          "pos": {
            "$ref": "#/definitions/vec3"
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      }
    },
    "hiding_spots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "room",
          "pos",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "room": {
            "type": "string"
          },
          "pos": {
            "$ref": "#/definitions/vec3"
          },
          "type": {
            "enum": [
              "locker",
              "closet",
              "under",
              "crate"
            ]
          }
        }
      }
    },
    "patrol_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "waypoints",
          "loop"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "loop": {
            "type": "boolean"
          },
          "waypoints": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/definitions/vec3"
            }
          }
        }
      }
    },
    "entity_spawns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "pos"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "pos": {
            "$ref": "#/definitions/vec3"
          }
        }
      }
    },
    "extractions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "level",
          "pos",
          "activatable"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "pos": {
            "$ref": "#/definitions/vec3"
          },
          "activatable": {
            "type": "boolean"
          }
        }
      }
    },
    "streaming_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "level",
          "bounds"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "bounds": {
            "type": "object",
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "$ref": "#/definitions/vec3"
              },
              "max": {
                "$ref": "#/definitions/vec3"
              }
            }
          }
        }
      }
    },
    "spawn": {
      "type": "object",
      "required": [
        "outside_pos",
        "approach_waypoints",
        "board_door"
      ],
      "additionalProperties": false,
      "properties": {
        "outside_pos": {
          "$ref": "#/definitions/vec3"
        },
        "approach_waypoints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/vec3"
          }
        },
        "board_door": {
          "$ref": "#/definitions/door"
        }
      }
    },
    "pacing": {
      "type": "object",
      "required": [
        "deepest_loot",
        "primary_extraction",
        "path_studs",
        "cautious_s",
        "loaded_escape_s",
        "targets"
      ],
      "additionalProperties": false,
      "properties": {
        "deepest_loot": {
          "type": "string"
        },
        "primary_extraction": {
          "type": "string"
        },
        "path_studs": {
          "type": "number"
        },
        "cautious_s": {
          "type": "number"
        },
        "loaded_escape_s": {
          "type": "number"
        },
        "targets": {
          "type": "object",
          "properties": {
            "deepest_cautious_s": {
              "type": "array"
            },
            "loaded_escape_s": {
              "type": "array"
            }
          }
        }
      }
    }
  }
}
